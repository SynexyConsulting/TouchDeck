<Project>
  <!-- One version for the app, its assembly info and the MSI. -->
  <PropertyGroup>
    <Version>1.2.1</Version>
    <Company>Touch Deck</Company>
    <Product>Touch Deck</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!-- Release builds embed no local source paths in PDBs or stack traces (they become /_/),
       and no Source Link: the repo is private, so its URLs would help no one. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
</Project>
