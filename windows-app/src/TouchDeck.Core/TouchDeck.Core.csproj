<Project Sdk="Microsoft.NET.Sdk">
  <!-- All Touch Deck logic: protocol, devices, input injection. No UI
       (UseWPF only for the UI Automation client assemblies). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TouchDeck.Tests" />
  </ItemGroup>

  <!-- The device mirror's renderers: the firmware's own page code (src/, esp32c3/src/) built
       with MSVC by hostui/build.bat into tdui_rp2040.dll, tdui_esp32c3.dll and tdui_rp2350.dll, then copied
       next to every exe that references Core (the app, the tests, the published MSI payload). -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))</RepoRoot>
    <TduiOut>$(MSBuildThisFileDirectory)obj\native</TduiOut>
  </PropertyGroup>
  <ItemGroup>
    <TduiSource Include="$(RepoRoot)hostui\*.c;$(RepoRoot)hostui\*.h;$(RepoRoot)hostui\build.bat" />
    <TduiSource Include="$(RepoRoot)src\*.c;$(RepoRoot)src\*.h;$(RepoRoot)esp32c3\src\*.c;$(RepoRoot)esp32c3\src\*.h" />
    <TduiSource Include="$(RepoRoot)src\round\*.c;$(RepoRoot)src\round\*.h;$(RepoRoot)src\boards\*.h" />
    <None Include="$(TduiOut)\tdui_rp2040.dll" Link="tdui_rp2040.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TduiOut)\tdui_esp32c3.dll" Link="tdui_esp32c3.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(TduiOut)\tdui_rp2350.dll" Link="tdui_rp2350.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="BuildTdui" BeforeTargets="BeforeBuild" Inputs="@(TduiSource)"
          Outputs="$(TduiOut)\tdui_rp2040.dll;$(TduiOut)\tdui_esp32c3.dll;$(TduiOut)\tdui_rp2350.dll">
    <Exec Command="&quot;$(RepoRoot)hostui\build.bat&quot; &quot;$(TduiOut)&quot;" />
  </Target>
</Project>
