<Window x:Class="TouchDeck.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Touch Deck Settings" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource Text}" KeyDown="OnKeyDown">
    <!-- Covers the main window: a dim scrim (click it to close) with the card centred on top. -->
    <Grid>
        <Border x:Name="Scrim" Background="#8C000000" MouseLeftButtonDown="OnScrimClick" />
        <Border x:Name="Card" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Surf}" CornerRadius="16" BorderBrush="#263042" BorderThickness="1" Padding="20,16,20,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" MinWidth="0" Padding="9,4" Content="✕"
                            Click="OnClose" ToolTip="Close (Esc)" />
                    <Path Data="{StaticResource CogIcon}" Fill="{StaticResource Dim}" Width="18" Height="18" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Settings" FontFamily="{StaticResource HeadFont}" FontSize="20" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Versions -->
                <Border Background="{StaticResource Inner}" CornerRadius="12" Padding="12,9" Margin="0,10,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="App Version" Margin="0,2" />
                        <TextBlock x:Name="AppVersionValue" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,2" />
                        <TextBlock x:Name="DeviceLabel" Grid.Row="1" Text="Device Firmware" Margin="0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.DeviceFirmwareText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="13" Margin="0,2" />
                    </Grid>
                </Border>

                <!-- Startup -->
                <TextBlock Text="Startup" Style="{StaticResource CardTitle}" Margin="0,12,0,4" />
                <CheckBox Content="Launch at startup" IsChecked="{Binding StartWithWindows}" />
                <CheckBox x:Name="MinimizedBox" Content="Start minimized in tray" IsChecked="{Binding StartMinimized}"
                          IsEnabled="{Binding StartWithWindows}" Margin="18,5,0,5" />

                <!-- Updates -->
                <TextBlock Text="Updates" Style="{StaticResource CardTitle}" Margin="0,12,0,4" />
                <CheckBox Content="Check for updates automatically" IsChecked="{Binding CheckForUpdates}" />
                <TextBlock Text="The app and the board's firmware are checked separately." Foreground="{StaticResource Faint}"
                           FontSize="12" Margin="0,0,0,8" />
                <Button x:Name="CheckNow" Content="Check for updates now" Tag="Primary" HorizontalAlignment="Left" Margin="0,0,0,8"
                        Click="OnCheckNow" />
                <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Install" Tag="Primary"
                            Visibility="{Binding CanInstallApp, Converter={StaticResource BoolVis}}" Click="OnInstallApp" />
                    <TextBlock FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="App:" Foreground="{StaticResource Text}" /> <Run Text="{Binding AppUpdateText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Install" Tag="Primary"
                            Visibility="{Binding Selected.CanInstallFirmware, Converter={StaticResource BoolVis}}" Click="OnInstallFirmware" />
                    <TextBlock FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="Firmware:" Foreground="{StaticResource Text}" /> <Run Text="{Binding Selected.FirmwareUpdateText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>

                <!-- Jiggler: the board's "Jiggler menu" panel, edited from here (firmware 1.8.0+) -->
                <TextBlock Text="Jiggler" Style="{StaticResource CardTitle}" Margin="0,14,0,4" />
                <TextBlock Text="{Binding Selected.JigNote}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                <StackPanel IsEnabled="{Binding Selected.HasJigConfig}">
                    <CheckBox x:Name="JigMenuBox" Content="Right-click context menu" IsChecked="{Binding Selected.JigMenuOn, Mode=OneWay}"
                              Click="OnJigMenu" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                        <TextBlock Text="Key" Width="150" VerticalAlignment="Center" />
                        <!-- Esc or F15: both are real choices, so the switch stays amber and the chosen side lights up -->
                        <TextBlock x:Name="JigEscLabel" Text="Esc" VerticalAlignment="Center" Cursor="Hand" FontWeight="SemiBold"
                                   MouseLeftButtonUp="OnJigKeyLabel" Style="{StaticResource KeySideLabel}" Tag="esc" />
                        <CheckBox x:Name="JigF15Switch" Style="{StaticResource ChoiceSwitch}" Margin="10,0"
                                  IsChecked="{Binding Selected.JigF15, Mode=OneWay}" Click="OnJigKey" ToolTip="Esc or F15" />
                        <TextBlock x:Name="JigF15Label" Text="F15" VerticalAlignment="Center" Cursor="Hand" FontWeight="SemiBold"
                                   MouseLeftButtonUp="OnJigKeyLabel" Style="{StaticResource KeySideLabel}" Tag="f15" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4" IsEnabled="{Binding Selected.JigMenuOn}">
                        <TextBlock Text="Menu open" Width="150" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SmallButton}" Content="-" Tag="open-1" Click="OnJigStep" MinWidth="34" />
                        <TextBlock Text="{Binding Selected.JigOpenText}" Width="52" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SmallButton}" Content="+" Tag="open+1" Click="OnJigStep" MinWidth="34" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Pause before next letter" Width="150" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SmallButton}" Content="-" Tag="pause-1" Click="OnJigStep" MinWidth="34" />
                        <TextBlock Text="{Binding Selected.JigPauseText}" Width="52" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SmallButton}" Content="+" Tag="pause+1" Click="OnJigStep" MinWidth="34" />
                    </StackPanel>
                </StackPanel>

                <!-- Advanced -->
                <TextBlock Text="Advanced" Style="{StaticResource CardTitle}" Margin="0,14,0,4" />
                <CheckBox Content="Dry run (log keys, don't type)" IsChecked="{Binding DryRun}" />
                <CheckBox Content="Board diagnostics" IsChecked="{Binding DiagnosticsEnabled}" />
                <TextBlock Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12">
                    <Run Text="Ctrl+Alt+C" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" />
                    <Run Text="sends the selected text (or the clipboard) to the board, like tapping COPY." />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
