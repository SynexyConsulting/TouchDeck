<Window x:Class="TouchDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TouchDeck.App"
        Title="Touch Deck" Width="1000" Height="880" MinWidth="840" MinHeight="620"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header: name on the left, Settings (versions, startup, updates) on the right -->
        <DockPanel Grid.ColumnSpan="3" Margin="2,0,0,14">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="OnSettings"
                    ToolTip="Settings: versions, startup, updates" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CogIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/app-256.png" Width="30" Height="30" Margin="0,0,10,0" />
                <TextBlock Text="Touch Deck" FontFamily="{StaticResource HeadFont}" FontSize="24" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Left: the device (live mirror) and its details -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,2,0">
                <Border x:Name="DeviceCard" Style="{StaticResource Card}" Padding="16,18">
                    <StackPanel>
                        <!-- Firmware 1.7.0+: the board's own screen, drawn by its own code -->
                        <local:DeviceMirror x:Name="Mirror" />
                        <TextBlock x:Name="MirrorHint" Text="Click to tap · drag sideways to swipe" Foreground="{StaticResource Faint}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />

                        <!-- Firmware 1.6.x: the jiggler card, as before -->
                        <StackPanel x:Name="LegacyJiggler" IsEnabled="{Binding IsConnected}">
                            <DockPanel x:Name="JigBody">
                                <Button x:Name="ScalePill" DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Margin="0"
                                        Content="{Binding JigScaleText}" Click="OnScale" ToolTip="Jiggler size: 1x, 1.5x, 2x" />
                                <Button x:Name="JigPill" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="OnJigToggle"
                                        ToolTip="Turn the jiggler on or off" />
                                <TextBlock Text="Jiggler" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </DockPanel>
                            <local:JiggleLane x:Name="JigLaneView" Height="120" Margin="0,6,0,0" Cursor="Hand"
                                              Letter="{Binding JigLetter}" DotX="{Binding JigX}" DotY="{Binding JigY}"
                                              Active="{Binding JigOn}" MouseLeftButtonUp="OnLaneClick"
                                              ToolTip="Tap the letter to turn the jiggler on or off" />
                            <TextBlock x:Name="JigStatusText" Text="{Binding JigStatus}" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="MirrorFallback" Text="{Binding MirrorFallbackText}" Foreground="{StaticResource Accent}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Device details -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BoardName}" FontFamily="{StaticResource HeadFont}" FontSize="19" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Port" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Port}" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="1" Text="Firmware" Style="{StaticResource Label}" />
                            <TextBlock x:Name="FirmwareText" Grid.Row="1" Grid.Column="1" Text="{Binding FirmwareVersion}" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="2" Text="Built" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FirmwareBuild}" Style="{StaticResource Value}" />
                        </Grid>
                        <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="UpdateButton" Content="Install firmware" Click="OnUpdate" IsEnabled="{Binding CanUpdate}" Margin="0,0,8,6" />
                            <Button Content="Bootloader" Click="OnBootloader" IsEnabled="{Binding IsConnected}" Margin="0,0,8,6"
                                    ToolTip="Reboot the board into its UF2 drive (RPI-RP2)" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: the remote pane and the activity log -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="96" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.6*" MinHeight="140" />
            </Grid.RowDefinitions>

            <!-- Remote -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConnected}">
                <StackPanel>
                    <TextBlock Text="Remote" Style="{StaticResource CardTitle}" />
                    <WrapPanel>
                        <Button Content="&#x25C0;  Page" Click="OnSwipeRight" Margin="0,0,6,6" Padding="11,6" ToolTip="Previous page (swipe right)" />
                        <Button Content="Page  &#x25B6;" Click="OnSwipeLeft" Margin="0,0,6,6" Padding="11,6" ToolTip="Next page (swipe left)" />
                        <StackPanel x:Name="BootButtons" Orientation="Horizontal">
                            <Button Content="BOOT" Click="OnButton" Margin="0,0,6,6" Padding="11,6"
                                    ToolTip="Press BOOT: start/pause the stopwatch, or change the jiggler size" />
                            <Button Content="Hold BOOT" Click="OnLongButton" Margin="0,0,6,6" Padding="11,6" ToolTip="Hold BOOT: reset the stopwatch" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Send to board" Style="{StaticResource CardTitle}" Margin="0,10,0,8" />
                    <TextBox x:Name="SendBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" TextChanged="OnSendTextChanged" />
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Tag="Primary" Click="OnSend" Margin="0" />
                        <TextBlock x:Name="SendInfo" Foreground="{StaticResource Dim}" VerticalAlignment="Center" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel x:Name="BoardClipRow" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="OnClearBoardClip"
                                IsEnabled="{Binding CanClearBoardClip}" ToolTip="Empty the board's clip (the trash can)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,6 H21 M9,6 V3 H15 V6 M6,9 L7,21 H17 L18,9 M10.5,11 V18 M13.5,11 V18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Clear" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding BoardClipText}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" FontSize="13" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Recent clips -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallButton}" Click="OnClearHistory"
                                VerticalAlignment="Top" />
                        <TextBlock Text="Recent clips (kept in memory only)" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="Clips you send appear here." Foreground="{StaticResource Faint}" x:Name="HistoryEmpty" />
                        <ListBox x:Name="HistoryList" ItemsSource="{Binding HistoryItems}" Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Inner}" CornerRadius="10" Padding="10,6" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SmallButton}"
                                                    Click="OnHistoryCopy" Tag="{Binding}" ToolTip="Put on the Windows clipboard" />
                                            <Button DockPanel.Dock="Right" Content="Resend" Style="{StaticResource SmallButton}"
                                                    Click="OnHistoryResend" Tag="{Binding}" />
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Diagnostics (Settings > Advanced) -->
            <Border x:Name="DiagCard" Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Board diagnostics" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding DiagnosticItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Inner}" CornerRadius="8" Padding="8,3" Margin="0,0,6,6">
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12">
                                        <Run Text="{Binding Key, Mode=OneWay}" Foreground="{StaticResource Dim}" />
                                        <Run Text="{Binding Value, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Activity log -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="Copy log" Style="{StaticResource SmallButton}" Click="OnCopyLog"
                                VerticalAlignment="Top" />
                        <TextBlock Text="Activity" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Style="{StaticResource PlainList}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Dim}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
