<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell; WinForms only for the tray NotifyIcon. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TouchDeck</AssemblyName>
    <RootNamespace>TouchDeck.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- English UI only: skips ~20 folders of framework resource translations. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only for NotifyIcon: keep its types out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.ico" />
    <Resource Include="Assets\app-256.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled board firmware (build.ps1 refreshes it from the firmware repo). -->
    <None Include="..\..\firmware\**" LinkBase="firmware" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TouchDeck.Core\TouchDeck.Core.csproj" />
  </ItemGroup>
</Project>
